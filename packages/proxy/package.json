{
  "name": "ldk-ws-proxy",
  "version": "0.1.0",
  "description": "WebSocket-to-TCP relay so a browser can reach a Lightning peer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ldk-ws-proxy": "dist/cli.js",
    "ldk-chain-proxy": "dist/chain-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && node dist/cli.js",
    "chain": "tsc -p tsconfig.json && node dist/chain-cli.js"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
